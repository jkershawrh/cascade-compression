{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade-compression.org/contracts/cascade.staging-manifest/1.0.0-alpha.3",
  "title": "Cascade Staging Manifest",
  "type": "object",
  "required": ["schema_version", "run", "candidate", "classification_arm", "model_revisions", "runtime_run_id", "audit_window", "ledger", "verification"],
  "properties": {
    "schema_version": {"const": "cascade.staging-manifest.v1alpha3"},
    "run": {
      "type": "object",
      "required": ["commit", "image_digest", "config_digest", "taxonomy_revision", "window_start", "window_end"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "config_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "taxonomy_revision": {"type": "string", "minLength": 1},
        "window_start": {"type": "string", "format": "date-time"},
        "window_end": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["schema_version", "repository", "commit", "image", "image_digest", "workflow_run_id", "workflow_run_attempt", "generated_at", "multi_arch", "sbom", "provenance"],
      "properties": {
        "schema_version": {"const": "cascade.staging-candidate.v1alpha1"},
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "image": {"type": "string", "minLength": 1},
        "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "workflow_run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "workflow_run_attempt": {"type": "integer", "minimum": 1},
        "generated_at": {"type": "string", "format": "date-time"},
        "multi_arch": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 2,
          "uniqueItems": true
        },
        "sbom": {"const": true},
        "provenance": {"const": true}
      },
      "additionalProperties": false
    },
    "classification_arm": {"type": "string", "minLength": 1},
    "model_revisions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "runtime_run_id": {"type": "string", "minLength": 1},
    "audit_window": {
      "type": "object",
      "required": ["stats_before_at", "stats_after_at"],
      "properties": {
        "stats_before_at": {"type": "string", "format": "date-time"},
        "stats_after_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "ledger": {
      "type": "object",
      "required": ["capacity_measured", "used_fraction", "alert_threshold", "outbox"],
      "properties": {
        "capacity_measured": {"const": true},
        "used_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "alert_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "outbox": {
          "type": "object",
          "required": ["status", "pending", "inflight", "failed", "oldest_pending_seconds", "policy", "archive_verified", "undelivered_deleted", "last_relay_success_at", "recovery_drill_at"],
          "properties": {
            "status": {"enum": ["healthy", "recovering", "stalled"]},
            "pending": {"type": "integer", "minimum": 0},
            "inflight": {"type": "integer", "minimum": 0},
            "failed": {"type": "integer", "minimum": 0},
            "oldest_pending_seconds": {"type": "number", "minimum": 0},
            "policy": {"const": "immutable-relay-and-archive-v1"},
            "archive_verified": {"type": "boolean"},
            "undelivered_deleted": {"type": "integer", "minimum": 0},
            "last_relay_success_at": {"type": "string", "format": "date-time"},
            "recovery_drill_at": {"type": "string", "format": "date-time"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["clean_clone_passed", "clean_clone_minutes", "tests_passed", "tests_failed", "tests_skipped", "package_smoke", "container_smoke", "sbom", "provenance", "ci_conclusion"],
      "properties": {
        "clean_clone_passed": {"type": "boolean"},
        "clean_clone_minutes": {"type": "number", "exclusiveMinimum": 0},
        "tests_passed": {"type": "integer", "minimum": 0},
        "tests_failed": {"type": "integer", "minimum": 0},
        "tests_skipped": {"type": "integer", "minimum": 0},
        "package_smoke": {"type": "boolean"},
        "container_smoke": {"type": "boolean"},
        "sbom": {"type": "boolean"},
        "provenance": {"type": "boolean"},
        "ci_conclusion": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
