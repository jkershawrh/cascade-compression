{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory-event.json",
  "title": "Memory Event",
  "description": "Audit trail for memory lifecycle transitions — formation, recall, consolidation, eviction, federation.",
  "type": "object",
  "required": ["memory_id", "event_type", "timestamp"],
  "properties": {
    "memory_id": {
      "type": "string",
      "description": "Memory this event applies to"
    },
    "event_type": {
      "type": "string",
      "enum": ["formed", "recalled", "consolidated", "evicted", "federated", "rejected", "verified", "classification_updated"],
      "description": "Type of lifecycle event"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO timestamp of the event"
    },
    "details": {
      "type": "object",
      "description": "Event-specific details (strength change, eviction reason, etc.)"
    }
  },
  "allOf": [{
    "if": {"properties": {"event_type": {"const": "classification_updated"}}},
    "then": {
      "required": ["details"],
      "properties": {"details": {
        "type": "object",
        "required": ["work_id", "signal_id", "event_id", "previous_classification", "classification", "classifier"],
        "properties": {
          "work_id": {"type": "string", "minLength": 1},
          "signal_id": {"type": "string", "minLength": 1},
          "event_id": {"type": "string", "minLength": 1},
          "previous_classification": {"type": "string"},
          "classification": {"enum": ["routine_noise", "known_pattern", "needs_attention", "real_incident"]},
          "classifier": {"type": "object"}
        }
      }}
    }
  }]
}
