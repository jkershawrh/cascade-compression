{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade-compression.org/contracts/cascade.staging-evidence/1.0.0-alpha.2",
  "title": "Cascade Staging Evidence",
  "type": "object",
  "required": ["schema_version", "status", "run", "candidate", "classification", "runtime", "audit", "artifact_digests", "gates", "failed_gates", "contains_raw_records"],
  "properties": {
    "schema_version": {"const": "cascade.staging-evidence.v1alpha2"},
    "status": {"enum": ["incomplete", "staging_success"]},
    "run": {
      "type": "object",
      "required": ["commit", "image_digest", "config_digest", "taxonomy_revision", "window_start", "window_end"]
    },
    "candidate": {
      "type": "object",
      "required": ["repository", "image", "image_digest", "workflow_run_id", "workflow_run_attempt", "manifest_digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "image": {"type": "string", "minLength": 1},
        "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "workflow_run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "workflow_run_attempt": {"type": "integer", "minimum": 1},
        "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "required": ["arm", "quality_profile", "model_revisions", "dataset_digest", "holdout_digest", "records", "coverage", "accuracy", "balanced_accuracy", "macro_f1", "dangerous_misses", "calibration"],
      "properties": {
        "quality_profile": {"const": "oss-rc-a-v1"}
      }
    },
    "runtime": {
      "type": "object",
      "required": ["quality_profile", "cells", "errors", "cpu_allocation_verified"],
      "properties": {"quality_profile": {"const": "oss-rc-runtime-v1"}}
    },
    "audit": {"type": "object"},
    "artifact_digests": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "passed", "evidence"],
        "properties": {
          "name": {"type": "string"},
          "passed": {"type": "boolean"}
        }
      }
    },
    "failed_gates": {"type": "array", "items": {"type": "string"}},
    "contains_raw_records": {"const": false}
  },
  "additionalProperties": true
}
