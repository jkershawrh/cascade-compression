{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade-compression.org/contracts/cascade.decision/1.0.0",
  "title": "Cascade Decision",
  "type": "object",
  "required": ["signal_id", "agent_name", "outcome", "confidence"],
  "properties": {
    "signal_id": {"type": "string", "format": "uuid"},
    "agent_name": {"type": "string"},
    "outcome": {"enum": ["keep", "drop", "suppress", "dedupe", "escalate", "classify"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "string", "default": ""},
    "classification": {"type": "string", "default": ""},
    "metadata": {"type": "object", "default": {}}
  },
  "additionalProperties": true
}
