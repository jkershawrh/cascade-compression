{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cascade-compression.org/contracts/cascade.holdout-manifest/1.0.0-alpha.2",
  "title": "Cascade Holdout Manifest",
  "type": "object",
  "required": ["schema_version", "dataset", "source_window", "frozen_at", "selection", "candidate_digest", "holdout_digest", "evaluation_design", "blinding", "contains_raw_records"],
  "properties": {
    "schema_version": {"const": "cascade.holdout-manifest.v1alpha2"},
    "dataset": {
      "type": "object",
      "required": ["name", "revision"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "frozen_at": {"type": "string", "format": "date-time"},
    "source_window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": ["algorithm", "seed_digest", "stratification_basis", "candidate_records", "selected_records", "strata"],
      "properties": {
        "algorithm": {"const": "sha256-rank-v1"},
        "seed_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "stratification_basis": {"type": "string", "minLength": 1},
        "candidate_records": {"type": "integer", "minimum": 1},
        "selected_records": {"type": "integer", "minimum": 1},
        "strata": {"type": "object", "minProperties": 1}
      },
      "additionalProperties": false
    },
    "candidate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "holdout_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evaluation_design": {
      "type": "object",
      "required": ["purpose", "prevalence_claim_permitted", "candidate_targets_are_ground_truth", "minimum_label_candidates", "selected_candidate_targets", "known_pattern_authority_prequalified"],
      "properties": {
        "purpose": {"enum": ["representative_prevalence", "label_coverage_challenge"]},
        "prevalence_claim_permitted": {"type": "boolean"},
        "candidate_targets_are_ground_truth": {"const": false},
        "minimum_label_candidates": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "selected_candidate_targets": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "known_pattern_authority_prequalified": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "blinding": {
      "type": "object",
      "required": ["evaluated_predictions_removed", "ground_truth_removed", "sampling_strata_removed", "candidate_case_ids_replaced"],
      "additionalProperties": {"const": true}
    },
    "contains_raw_records": {"const": false}
  },
  "additionalProperties": false
}
